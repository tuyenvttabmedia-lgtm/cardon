// =============================================================================
// PAYMENT
// =============================================================================

model PaymentGateway {
  id              String               @id @default(uuid()) @db.Uuid
  code            String               @unique @db.VarChar(64)
  name            String               @db.VarChar(255)
  configEncrypted String               @map("config_encrypted") @db.Text
  status          PaymentGatewayStatus @default(ACTIVE)
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("payment_gateways")
}

model Payment {
  id                   String                      @id @default(uuid()) @db.Uuid
  orderId              String                      @map("order_id") @db.Uuid
  gateway              PaymentGatewayCode
  methodCode           String?                     @map("method_code") @db.VarChar(64)
  settlementType       PaymentSettlementType?      @map("settlement_type")
  paymentReference     String                      @unique @map("payment_reference") @db.VarChar(128)
  idempotencyKey       String?                     @unique @map("idempotency_key") @db.VarChar(128)
  amount               Decimal                     @db.Decimal(18, 2)
  /// Phase 1: nullable. Retail rows stay null. eSIM SePay writes VND.
  currency             String?                     @db.Char(3)
  /// Phase 1: nullable. Set only by a later eSIM payment path.
  productLane          String?                     @map("product_lane") @db.VarChar(16)
  fxRateId             String?                     @map("fx_rate_id") @db.Uuid
  status               PaymentRecordStatus         @default(PENDING)
  gatewayTransactionId String?                     @map("gateway_transaction_id") @db.VarChar(128)
  bankTransactionId    String?                     @map("bank_transaction_id") @db.VarChar(128)
  bankReference        String?                     @map("bank_reference") @db.VarChar(128)
  settlementDate       DateTime?                   @map("settlement_date") @db.Timestamptz(6)
  reconciliationStatus PaymentReconciliationStatus @default(PENDING) @map("reconciliation_status")
  gatewayResponse      Json                        @default("{}") @map("gateway_response")
  paidAt               DateTime?                   @map("paid_at") @db.Timestamptz(6)
  expiresAt            DateTime?                   @map("expires_at") @db.Timestamptz(6)
  createdAt            DateTime                    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime                    @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt            DateTime?                   @map("deleted_at") @db.Timestamptz(6)

  order            Order            @relation("PaymentOrder", fields: [orderId], references: [id], onDelete: Restrict)
  orderAsActive    Order?           @relation("OrderActivePayment")
  fxRate           FxRate?          @relation(fields: [fxRateId], references: [id], onDelete: Restrict)
  refundRequests   RefundRequest[]
  paypalFeeMatches PaypalFeeMatch[]

  @@index([orderId])
  @@index([paymentReference])
  @@index([gatewayTransactionId])
  @@index([bankReference])
  @@index([settlementDate])
  @@index([reconciliationStatus])
  @@index([settlementType])
  @@index([deletedAt])
  @@map("payments")
}

/// Business refund request. Reservation (REQUESTED|APPROVED|PROCESSING) plus
/// SUCCEEDED amounts must not exceed the source Payment.amount — enforced in
/// service transactions, not by a database CHECK.
model RefundRequest {
  id             String               @id @default(uuid()) @db.Uuid
  orderId        String               @map("order_id") @db.Uuid
  paymentId      String               @map("payment_id") @db.Uuid
  amount         Decimal              @db.Decimal(18, 2)
  currency       RefundCurrency
  reason         String               @db.VarChar(512)
  status         RefundRequestStatus  @default(REQUESTED)
  intendedMethod RefundIntendedMethod @map("intended_method")
  esimGate       RefundEsimGate       @default(NONE) @map("esim_gate")
  requestedById  String               @map("requested_by_id") @db.Uuid
  approvedById   String?              @map("approved_by_id") @db.Uuid
  cancelledById  String?              @map("cancelled_by_id") @db.Uuid
  approvedAt     DateTime?            @map("approved_at") @db.Timestamptz(6)
  cancelledAt    DateTime?            @map("cancelled_at") @db.Timestamptz(6)
  completedAt    DateTime?            @map("completed_at") @db.Timestamptz(6)
  evidence       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

  order       Order           @relation(fields: [orderId], references: [id], onDelete: Restrict)
  payment     Payment         @relation(fields: [paymentId], references: [id], onDelete: Restrict)
  requestedBy User            @relation("RefundRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy  User?           @relation("RefundRequestApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  cancelledBy User?           @relation("RefundRequestCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  attempts    RefundAttempt[]

  @@index([orderId])
  @@index([paymentId, status])
  @@index([status])
  @@index([requestedById])
  @@map("refund_requests")
}

/// One execution or outcome query. openGuard = requestId while SENT/UNCONFIRMED
/// so a request has at most one open attempt. Timeout stays UNCONFIRMED and
/// does not clear openGuard — reservation remains until FAILED or SUCCEEDED.
model RefundAttempt {
  id                       String               @id @default(uuid()) @db.Uuid
  requestId                String               @map("request_id") @db.Uuid
  amount                   Decimal              @db.Decimal(18, 2)
  currency                 RefundCurrency
  status                   RefundAttemptStatus  @default(SENT)
  reconStatus              RefundReconStatus    @default(PENDING_VERIFY) @map("recon_status")
  method                   RefundIntendedMethod
  idempotencyKey           String               @unique @map("idempotency_key") @db.VarChar(128)
  /// Set to requestId while SENT or UNCONFIRMED. Null when closed.
  openGuard                String?              @unique @map("open_guard") @db.Uuid
  providerRefundRef        String?              @map("provider_refund_ref") @db.VarChar(128)
  bankTransactionReference String?              @map("bank_transaction_reference") @db.VarChar(128)
  destinationHint          String?              @map("destination_hint") @db.VarChar(128)
  transferredAt            DateTime?            @map("transferred_at") @db.Timestamptz(6)
  executedById             String?              @map("executed_by_id") @db.Uuid
  verifiedById             String?              @map("verified_by_id") @db.Uuid
  verifiedAt               DateTime?            @map("verified_at") @db.Timestamptz(6)
  statementEvidenceRef     String?              @map("statement_evidence_ref") @db.VarChar(128)
  errorCode                String?              @map("error_code") @db.VarChar(64)
  errorMessage             String?              @map("error_message") @db.VarChar(512)
  safeRequestMeta          Json                 @default("{}") @map("safe_request_meta")
  safeResponseMeta         Json                 @default("{}") @map("safe_response_meta")
  createdAt                DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)

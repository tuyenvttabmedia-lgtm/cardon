  chargeCurrency    String?                @map("charge_currency") @db.Char(3)
  chargeAmount      Decimal?               @map("charge_amount") @db.Decimal(18, 2)
  costCurrency      String?                @map("cost_currency") @db.Char(3)
  costAmount        Decimal?               @map("cost_amount") @db.Decimal(18, 4)

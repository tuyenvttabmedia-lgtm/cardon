  @@map("cms_seo_translations")
}

model CmsCategoryTranslation {
  id              String           @id @default(uuid()) @db.Uuid
  categoryId      String           @map("category_id") @db.Uuid
  locale          CmsContentLocale
  name            String           @db.VarChar(128)
  description     String?          @db.VarChar(512)
  intro           String?          @db.Text
  metaTitle       String?          @map("meta_title") @db.VarChar(128)
  metaDescription String?          @map("meta_description") @db.VarChar(256)
  canonicalUrl    String?          @map("canonical_url") @db.VarChar(512)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  category CmsCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, locale])
  @@index([categoryId, locale])
  @@map("cms_category_translations")
}

model CmsTagTranslation {
  id              String           @id @default(uuid()) @db.Uuid
  tagId           String           @map("tag_id") @db.Uuid
  locale          CmsContentLocale
  name            String           @db.VarChar(128)
  metaTitle       String?          @map("meta_title") @db.VarChar(128)
  metaDescription String?          @map("meta_description") @db.VarChar(256)
  createdAt       DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)

  tag CmsTag @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@unique([tagId, locale])
  @@index([tagId, locale])
  @@map("cms_tag_translations")
}

model CmsBanner {
  id        String            @id @default(uuid()) @db.Uuid
  title     String            @db.VarChar(255)
  imageUrl  String            @map("image_url") @db.VarChar(512)
  linkUrl   String?           @map("link_url") @db.VarChar(512)
  position  CmsBannerPosition
  sortOrder Int               @default(0) @map("sort_order")
  status    CmsBannerStatus   @default(ACTIVE)
  startAt   DateTime?         @map("start_at") @db.Timestamptz(6)
  endAt     DateTime?         @map("end_at") @db.Timestamptz(6)
  createdAt DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)


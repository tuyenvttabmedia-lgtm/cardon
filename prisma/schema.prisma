// =============================================================================
// FX — empty until an admin publishes a manual rate. No default row.
// =============================================================================

enum FxRateSourceStatus {
  PENDING_APPROVAL
  APPROVED
  DISABLED
}

enum FxRateStatus {
  DRAFT
  PENDING_REVIEW
  EFFECTIVE
  SUPERSEDED
  REJECTED
}

/// Future automatic sources stay unapproved. Phase 1 inserts nothing.
model FxRateSource {
  code                 String             @id @db.VarChar(32)
  status               FxRateSourceStatus @default(PENDING_APPROVAL)
  baseCurrency         String             @map("base_currency") @db.Char(3)
  quoteCurrency        String             @map("quote_currency") @db.Char(3)
  maxStalenessSeconds  Int?               @map("max_staleness_seconds")
  fetchIntervalSeconds Int?               @map("fetch_interval_seconds")
  createdAt            DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  rates FxRate[]

  @@map("fx_rate_sources")
}

/// Append-only. rate = VND for 1 USD when base is USD and quote is VND.
model FxRate {
  id             String       @id @default(uuid()) @db.Uuid
  sourceCode     String       @map("source_code") @db.VarChar(32)
  rate           Decimal      @db.Decimal(18, 8)
  effectiveFrom  DateTime     @map("effective_from") @db.Timestamptz(6)
  effectiveTo    DateTime?    @map("effective_to") @db.Timestamptz(6)
  observedAt     DateTime     @map("observed_at") @db.Timestamptz(6)
  publishedById  String?      @map("published_by") @db.Uuid
  status         FxRateStatus @default(DRAFT)
  bandResult     String?      @map("band_result") @db.VarChar(32)
  createdAt      DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)

  source   FxRateSource    @relation(fields: [sourceCode], references: [code], onDelete: Restrict)
  orders   Order[]
  payments Payment[]
  quotes   EsimOrderQuote[]

  @@index([sourceCode, status])
  @@map("fx_rates")
}

